# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# API base (no trailing slash after /api). Must match Spring Boot host:port; if 8080 is busy the app may use 8081.
# Local: http://localhost:8080/api
VITE_API_BASE_URL=https://your-api-domain.com/api

# Public landing-page AI (Vercel serverless /api/chat). On Vercel production, leave unset to use same-origin /api/chat.
# Pure "vite" dev: browser calls /api/chat on :5173 — that route does not exist unless you proxy or point to prod:
# Option A — proxy (recommended): origin only, no path (not exposed to client bundle if you use PUBLIC_AI_ prefix)
# PUBLIC_AI_DEV_PROXY=https://your-app.vercel.app
# Option B — call deployed API directly from the browser:
# VITE_PUBLIC_AI_CHAT_URL=https://your-app.vercel.app/api/chat
# Option C — run: npx vercel dev (serves both Vite build and /api)

# Add these only in the Vercel dashboard (server secrets — never VITE_*):
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL_ID=gemini-3.1-flash-lite-preview
